---
import { site } from '../site';
const year = new Date().getFullYear();
---
<!-- footer start -->

<footer class="site-footer" role="contentinfo">
  <p class="footer-subscribe">
    <a href="/subscribe/">Get new summaries by email</a>{' · '}
    <a href="/feed.xml"><svg class="icon-rss" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><circle cx="2.5" cy="13.5" r="2.5" fill="currentColor"/><path d="M1 6a9 9 0 0 1 9 9h-2.5A6.5 6.5 0 0 0 1 8.5zM1 1a14 14 0 0 1 14 14h-2.5A11.5 11.5 0 0 0 1 3.5z" fill="currentColor"/></svg> RSS feed</a>
  </p>
  <div class="inner">
    <section class="copyright">All content &copy; {site.author}, {site.since}-{year}</section>
  </div>
</footer>

<!-- footer end -->
