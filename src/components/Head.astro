---
import { site, absoluteUrl } from '../site';
import { jsonLd, truncate, twitterCard, type ShareMeta } from '../lib/seo';
import { xmlSchemaDate } from '../lib/content';
import { publicImageSize } from '../lib/images.js';

export interface Props {
  /** Keep this page out of search results (the 404 page). */
  noindex?: boolean;
  /** Full <title> text (see pageTitle()). */
  title: string;
  description: string;
  /** Site-relative path of this page, e.g. "/about/". */
  path: string;
  /** Share-card image and article metadata (Open Graph / Twitter). */
  share?: ShareMeta;
  /** JSON-LD objects to embed in <head>. */
  schemas?: unknown[];
}

const { title, description, path, share = {}, schemas = [], noindex = false } = Astro.props;
const url = absoluteUrl(path);
const imagePath = share.image ?? site.logo;
const image = absoluteUrl(imagePath);
const imageSize = publicImageSize(imagePath, path);
const imageAlt = share.imageAlt && truncate(share.imageAlt, 420);
const article = share.article;
const shareTitle = share.title ?? title;
---
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>{title}</title>
  <meta name="description" content={description} />

  <meta name="HandheldFriendly" content="True" />
  <meta name="MobileOptimized" content="320" />
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="twitter:card" content={twitterCard(imageSize)} />
  <meta name="twitter:title" content={shareTitle} />
  <meta name="twitter:image" content={image} />
  {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
  <meta name="twitter:description" content={description} />

  <meta property="og:site_name" content={site.title} />
  <meta property="og:title" content={shareTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content={String(imageSize.width)} />
  <meta property="og:image:height" content={String(imageSize.height)} />
  {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  {article && (
    <>
      <meta property="article:published_time" content={xmlSchemaDate(article.published)} />
      <meta property="article:modified_time" content={xmlSchemaDate(article.modified ?? article.published)} />
      <meta property="article:author" content={absoluteUrl('/about/')} />
      {article.sections.map((section) => <meta property="article:section" content={section} />)}
    </>
  )}

  <meta name="author" content={site.author}>
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}>
  <meta name="theme-color" content="#ffffff">

  <link rel="canonical" href={url} />

  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Preconnect to external domains to improve performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://assets.mailerlite.com" crossorigin>
  <link rel="preconnect" href="https://www.google-analytics.com" crossorigin>

  {/* Only the styles the CSS uses: Jost 400–700 (body, with italics for captions and quotes),
      Merriweather 400 and 700 (headings). */}
  <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400..700;1,400..700&family=Merriweather:wght@400;700&display=swap" rel="stylesheet">

  <!-- Stylesheets are compiled from src/styles/ by src/pages/css/[name].css.ts -->
  <link rel="stylesheet" type="text/css" media="screen" href="/css/main.css" />
  <link rel="stylesheet" type="text/css" media="print" href="/css/print.css" />
  <link rel="stylesheet" type="text/css" media="screen" href="/css/tooltip.css" />
  <link rel="stylesheet" type="text/css" media="screen" href="/css/pages.css" />
  <link rel="stylesheet" type="text/css" media="screen" href="/css/components.css" />

  <!-- JSON-LD Structured Data -->
  {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={jsonLd(schema)} />)}

  <!-- MailerLite Universal -->
  <script is:inline>
    (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
    .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
    n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
    (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
    ml('account', '864413');
  </script>
  <!-- End MailerLite Universal -->
</head>
