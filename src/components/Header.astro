---
import { site } from '../site';

export interface Props {
  path: string;
}
const { path } = Astro.props;
const isHome = path === '/';
// "page" for the page itself, "true" for pages inside its section (e.g. a theme under Research Themes).
const current = (url: string) =>
  path === url ? 'page' : url !== '/' && path.startsWith(url) ? 'true' : undefined;
const navClass = (url: string) => (url === '/subscribe/' ? 'nav-subscribe' : undefined);
---
<!-- header start -->

<!-- Google tag (gtag.js) -->
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`}></script>
<script is:inline set:html={`
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', '${site.analyticsId}');
`} />

{isHome ? (
  <>
    <div class="teaserimage">
      <div class="teaserimage-image" data-bg-image={site.cover}>
        <h1 class="blog-title">{site.title}</h1>
        <div class="blog-subtitle">{site.description}</div>

        <button class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="site-navigation">
          <span class="menu-icon">
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
          </span>
        </button>

        <div class="custom-links" id="site-navigation" role="navigation" aria-label="Main navigation">
          {/* The spaces between links are part of the layout (inline elements). */}
          {site.menuItems.map((item) => (
            <>
              <a href={item.url} class={navClass(item.url)} aria-current={current(item.url)}>{item.title}</a>{' '}
            </>
          ))}
        </div>

      </div>
    </div>

    <header class="blog-header">
      <a class="blog-logo" href={`${site.url}/`} data-bg-image={site.logo} aria-label={`${site.title} - Return to homepage`}>{site.title}</a>
    </header>
  </>
) : (
  /* Every other page: a slim bar, so the page's own content starts near the top. */
  <header class="site-bar">
    <div class="site-bar-inner">
      <a class="site-bar-brand" href="/">
        <img src="/assets/images/logo-96.png" alt="" width="36" height="36" />
        <span>{site.title}</span>
      </a>

      <button class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="site-navigation">
        <span class="menu-icon">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </span>
      </button>

      <nav class="custom-links" id="site-navigation" aria-label="Main navigation">
        {site.menuItems.map((item) => (
          <a href={item.url} class={navClass(item.url)} aria-current={current(item.url)}>{item.title}</a>
        ))}
      </nav>
    </div>
  </header>
)}

<!-- header end -->
