---
import { site } from '../site';

export interface Props {
  path: string;
}
const { path } = Astro.props;
const isHome = path === '/';
---
<!-- header start -->

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XV8N5DDQYP"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-XV8N5DDQYP');
</script>

<div class="teaserimage">
  <div class="teaserimage-image" data-bg-image={site.cover}>
    {/* h1 on the front page; a div elsewhere to avoid duplicate h1s */}
    {isHome ? <h1 class="blog-title">{site.title}</h1> : <div class="blog-title">{site.title}</div>}
    <div class="blog-subtitle">{site.description}</div>

    <button class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="site-navigation">
      <span class="menu-icon">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </span>
    </button>

    <div class="custom-links" id="site-navigation" role="navigation" aria-label="Main navigation">
      {/* The spaces between links are part of the layout (inline elements). */}
      {site.menuItems.map((item) => (
        <>
          <a href={item.url} aria-current={path === item.url ? 'page' : undefined}>{item.title}</a>{' '}
        </>
      ))}
    </div>

  </div>
</div>

<header class="blog-header">
  <a class="blog-logo" href={`${site.url}/`} data-bg-image={site.logo} aria-label={`${site.title} - Return to homepage`}>{site.title}</a>
</header>

<!-- header end -->
