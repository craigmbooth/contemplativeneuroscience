---
// Standard content page (About, Glossary, All Papers, Research Themes).
// Also usable as a markdown layout: `layout: ../layouts/PageLayout.astro`.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Subscribe from '../components/Subscribe.astro';
import { breadcrumbSchema, metaDescription, pageTitle, profilePageSchema } from '../lib/seo';

export interface Props {
  title?: string;
  meta_description?: string;
  /** Extra JSON-LD for this page. */
  schemas?: unknown[];
  /** End the page with the email sign-up box. */
  subscribe?: boolean;
  /** Present when used as a markdown layout. */
  frontmatter?: { title: string; meta_description?: string; profile_page?: boolean; subscribe?: boolean };
}

const props = Astro.props;
const title = props.frontmatter?.title ?? props.title ?? '';
const description = metaDescription({
  metaDescription: props.frontmatter?.meta_description ?? props.meta_description,
});
const path = Astro.url.pathname;
const subscribe = props.frontmatter?.subscribe ?? props.subscribe ?? false;
const schemas = [
  breadcrumbSchema([{ name: title, path }]),
  // `profile_page: true` marks a page about the author (the About page).
  ...(props.frontmatter?.profile_page ? [profilePageSchema()] : []),
  ...(props.schemas ?? []),
];
---
<BaseLayout
  title={pageTitle(title)}
  description={description}
  path={path}
  schemas={schemas}
  bodyItemtype="http://schema.org/Article"
>
  <main class="content reading" role="main">
    <article class="post">
      <div class="noarticleimage">
        <div class="post-meta">
          <h1 class="post-title">{title}</h1>
        </div>
      </div>
      <br>

      <Breadcrumbs kind="page" title={title} />

      <section class="post-content">
        <a name="topofpage"></a>
        <slot />
        {subscribe && <Subscribe />}
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>
