---
// A paper summary.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import PaperMeta from '../components/PaperMeta.astro';
import Subscribe from '../components/Subscribe.astro';
import { site } from '../site';
import { articleSchema, breadcrumbSchema, metaDescription, pageTitle, postBreadcrumbs, type ShareMeta } from '../lib/seo';
import { CARD_HEIGHT, CARD_WIDTH } from '../lib/share-card';
import { displayDate, markdownify, postCard, postUrl, relatedPosts, themesForPost, themeUrl, type Post } from '../lib/content';

export interface Props {
  post: Post;
}
const { post } = Astro.props;
const { data } = post;
const path = postUrl(post);
const themes = await themesForPost(post);
const related = await relatedPosts(post);
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
const updated = data.last_modified_at && isoDate(data.last_modified_at) !== isoDate(data.date) ? data.last_modified_at : undefined;
const citation = (await markdownify(data.citation)).replaceAll('<p>', '<p class="citation">');
const share: ShareMeta = {
  // Social cards show the plain-language headline; <title> stays search-focused (seo_title).
  title: data.title,
  // A generated card: the theme painting beside the headline (lib/share-card.ts).
  image: postCard(post),
  imageSize: { width: CARD_WIDTH, height: CARD_HEIGHT },
  imageAlt: data.title,
  article: { published: data.date, modified: data.last_modified_at, sections: themes.map((t) => t.data.title) },
};
const schemas = [await articleSchema(post, path), breadcrumbSchema(await postBreadcrumbs(post, path))];
---
<BaseLayout
  title={pageTitle(data.title, data.seo_title)}
  description={metaDescription({ metaDescription: data.meta_description, snippet: data.snippet })}
  path={path}
  share={share}
  schemas={schemas}
>
  <main class="content reading" role="main">
    <article class="post">
      <div class="noarticleimage">
        <div class="post-meta">
          <h1 class="post-title">{data.title}</h1>
        </div>
      </div>
      <br>

      <Breadcrumbs kind="post" title={data.title} themes={themes} />

      <section class="post-content">
        <p class="post-byline">
          By <a href="/about/" rel="author">{site.author}</a>
          {' · '}Published <time datetime={isoDate(data.date)}>{displayDate(data.date)}</time>
          {updated && <>{' · '}Updated <time datetime={isoDate(updated)}>{displayDate(updated)}</time></>}
        </p>
        {data.snippet && (
          <aside class="key-finding" aria-labelledby="key-finding-label">
            <p id="key-finding-label" class="key-finding-label">In brief</p>
            <p>{data.snippet}</p>
          </aside>
        )}
        {data.study && (
          <aside class="study-glance" aria-labelledby="study-glance-label">
            <p id="study-glance-label" class="study-glance-label">Study at a glance</p>
            <dl>
              <dt>Study type</dt>
              <dd>{data.study.design}</dd>
              <dt>Participants</dt>
              <dd>{data.study.participants}</dd>
              {data.study.method && <><dt>Method</dt><dd>{data.study.method}</dd></>}
              {data.study.measures && <><dt>Measured</dt><dd>{data.study.measures}</dd></>}
              <dt>Keep in mind</dt>
              <dd>{data.study.limitations}</dd>
            </dl>
          </aside>
        )}
        <slot />
        {citation && (
          <>
            <h3>Citation</h3>
            <Fragment set:html={citation} />
          </>
        )}
        <Subscribe heading="Get the next summary by email" />
        {related.length > 0 && (
          <nav class="related-papers" aria-labelledby="related-papers-heading">
            <h2 id="related-papers-heading">Related Papers</h2>
            <ul>
              {related.map((p) => (
                <li><PaperMeta post={p} /><a href={postUrl(p)}>{p.data.title}</a></li>
              ))}
            </ul>
            <p class="related-papers-more">
              {themes.map((theme, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={themeUrl(theme)}>All papers on {theme.data.title}</a>
                </>
              ))}
            </p>
          </nav>
        )}
      </section>
    </article>
  </main>
  <Footer />
  <script is:inline src="/assets/js/figures.min.js"></script>
</BaseLayout>
