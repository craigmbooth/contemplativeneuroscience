---
// A research theme: description plus the papers in it.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import PaperMeta from '../components/PaperMeta.astro';
import { breadcrumbSchema, collectionPageSchema, htmlToText, metaDescription, pageTitle } from '../lib/seo';
import { publicImageSize } from '../lib/images.js';
import { markdownify, postsForTheme, postUrl, relatedThemes, themeImage, themeThumb, themeUrl, type Theme } from '../lib/content';

export interface Props {
  theme: Theme;
}
const { theme } = Astro.props;
const { data } = theme;
const path = themeUrl(theme);
const posts = await postsForTheme(theme);
const related = await relatedThemes(theme);
const image = { src: themeImage(theme), ...publicImageSize(themeImage(theme), path) };
const descriptionHtml = await markdownify(data.theme_description);
const summaryHtml = await markdownify(data.research_summary);
const citations = await Promise.all(posts.map((post) => markdownify(post.data.citation)));
const description = metaDescription({ metaDescription: data.meta_description, themeDescription: data.theme_description });
const schemas = [
  collectionPageSchema({
    path,
    name: data.title,
    description,
    abstract: summaryHtml ? htmlToText(summaryHtml) : undefined,
    items: posts.map((post) => ({ name: post.data.title, path: postUrl(post) })),
  }),
  breadcrumbSchema([
    { name: 'Research Themes', path: '/themes/' },
    { name: data.title, path },
  ]),
];
---
<BaseLayout
  title={pageTitle(data.title)}
  description={description}
  path={path}
  share={{ image: image.src }}
  schemas={schemas}
  wrapped
>
  <main class="content reading" role="main">
    <article class="post">
      <div class="noarticleimage">
        <div class="post-meta">
          <h1 class="post-title">{data.title}</h1>
        </div>
      </div>
      <Breadcrumbs kind="theme" title={data.title} />

      <section class="post-content">
        <div class="theme-header">
          <div class="theme-image">
            {/* Decorative: the theme title is the h1 above. */}
            <img src={image.src} alt="" width={image.width} height={image.height}>
          </div>
          <div class="theme-description">
            <Fragment set:html={descriptionHtml} />
          </div>
        </div>

        {summaryHtml && (
          <section class="research-summary" aria-labelledby="research-summary-heading">
            <h2 id="research-summary-heading">What the Research Says</h2>
            <Fragment set:html={summaryHtml} />
          </section>
        )}

        <h2>Papers in this Theme</h2>

        {posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post, i) => (
              <li>
                <PaperMeta post={post} />
                <h3>
                  <a class="post-link" href={postUrl(post)}>{post.data.title}</a>
                </h3>
                <p>{post.data.snippet}</p>
                <div class="post-meta citation">
                  <Fragment set:html={citations[i]} />
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p>No papers have been categorized in this theme yet.</p>
        )}

        {related.length > 0 && (
          <nav class="related-themes" aria-labelledby="related-themes-heading">
            <h2 id="related-themes-heading">Related Themes</h2>
            <ul>
              {related.map(({ theme: t, shared }) => (
                <li>
                  <img src={themeThumb(t)} alt="" width="240" height="240" loading="lazy" decoding="async" />
                  <div>
                    <a href={themeUrl(t)}>{t.data.question}</a>
                    <p class="paper-meta">{t.data.short_title} · {shared} shared paper{shared === 1 ? '' : 's'}</p>
                  </div>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>
