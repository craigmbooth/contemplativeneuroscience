---
import PageLayout from '../layouts/PageLayout.astro';
import { getPosts, markdownify, postUrl, themesForPost, themeUrl } from '../lib/content';

const posts = await getPosts();
const items = await Promise.all(
  posts.map(async (post) => ({
    post,
    citation: await markdownify(post.data.citation),
    themes: await themesForPost(post),
  })),
);
---
<PageLayout
  title="All Papers"
  meta_description="Browse, search, and sort every research summary on the site: peer-reviewed studies on meditation, mindfulness, and the brain."
>
  <p>This page provides a collection of {posts.length} research paper summaries available on the site. You can browse, search, and sort these papers by title, year, or author. Each summary offers an accessible overview of peer-reviewed research on contemplative practices and their effects on the brain, cognition, and well-being.</p>

  <div class="search-container">
    <input type="text" id="paperSearch" class="search-input" placeholder="Search paper titles..." aria-label="Search paper titles">
    <button id="clearSearch" class="clear-search-btn" aria-label="Clear search">×</button>
  </div>

  <div class="sort-controls">
    <span class="sort-label">Sort by:</span>
    <div class="sort-buttons">
      <button id="sortByTitle" class="sort-button active" data-sort="title" aria-label="Sort by title">
        Title <span class="sort-arrow">↓</span>
      </button>
      <button id="sortByYear" class="sort-button" data-sort="year" aria-label="Sort by publication year">
        Publication Year <span class="sort-arrow">↓</span>
      </button>
      <button id="sortByAuthor" class="sort-button" data-sort="author" aria-label="Sort by first author">
        First Author <span class="sort-arrow">↓</span>
      </button>
    </div>
  </div>

  <p id="searchResults" class="search-results-info" aria-live="polite"></p>

  <div class="all-papers-list">
    {items.map(({ post, citation, themes }) => (
      <article class="post-item" itemscope itemtype="http://schema.org/BlogPosting" role="article">
        <div class="article-item">
          <header class="post-header">
            <h3 class="post-title" itemprop="name"><a href={postUrl(post)} itemprop="url">{post.data.title}</a></h3>
          </header>
          <section class="post-excerpt" itemprop="description">
            <p>{post.data.snippet}</p>
          </section>
          <div class="post-meta citation">
            <Fragment set:html={citation} />
          </div>
          <div class="post-themes">
            {post.data.theme.length > 0 && <><span class="theme-label">Themes:</span>{' '}</>}
            {themes.map((theme, i) => (
              <>
                <a href={themeUrl(theme)} class="theme-tag">{theme.data.title}</a>{i < themes.length - 1 && ', '}
              </>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>

  <script is:inline src="/assets/js/all-papers.min.js"></script>
</PageLayout>
