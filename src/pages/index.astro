---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import { websiteSchema } from '../lib/seo';
import { getPosts, postUrl } from '../lib/content';

const posts = await getPosts();
const recent = posts.slice(0, 5);
const description =
  'Accessible summaries of peer-reviewed research on meditation and the brain, from jhana and gamma waves to sleep, immune function, and mind wandering.';
---
<DefaultLayout
  title="Home"
  meta_description={description}
  schemas={[websiteSchema(description)]}
>
  <main class="content" role="main">

    <p>
      This site collects accessible summaries of peer-reviewed research at the intersection of meditation and brain science. As a meditation practitioner and scientist, I'm fascinated by how contemplative practices shape cognition, emotion, and identity. My aim is to make this research understandable and meaningful to others who share this curiosity—whether you're a fellow practitioner, a researcher, or just meditation-curious.
    </p>

    <div class="content-cards">
      <div class="content-card">
        <h2>Research Themes</h2>
        <p>Browse papers organized by key research areas in contemplative neuroscience, from neurological correlates to biological health effects.</p>
        <a href="/themes/" class="card-button">Explore Themes</a>
      </div>

      <div class="content-card">
        <h2>All Papers</h2>
        <p>Browse, search, and sort the complete collection of research paper summaries.</p>
        <a href="/all-papers/" class="card-button">View All Papers</a>
      </div>

      <div class="content-card">
        <h2>Glossary</h2>
        <p>Learn about key terms and concepts in contemplative neuroscience and meditation research.</p>
        <a href="/glossary/" class="card-button">View Glossary</a>
      </div>
    </div>

    <section class="recent-papers" aria-labelledby="recent-papers-heading">
      <h2 id="recent-papers-heading">Recent Papers</h2>
      <ul class="post-list">
        {recent.map((post) => (
          <li>
            <h3><a class="post-link" href={postUrl(post)}>{post.data.title}</a></h3>
            {post.data.snippet && <p>{post.data.snippet}</p>}
          </li>
        ))}
      </ul>
      <p><a href="/all-papers/">Browse all {posts.length} papers</a></p>
    </section>
  </main>
</DefaultLayout>
