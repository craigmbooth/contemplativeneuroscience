---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import PaperMeta from '../components/PaperMeta.astro';
import { websiteSchema } from '../lib/seo';
import { site } from '../site';
import {
  getPosts,
  getThemes,
  postsBySlug,
  postsForTheme,
  postUrl,
  themesForPost,
  themeThumb,
  themeUrl,
  type Post,
} from '../lib/content';

const posts = await getPosts();
const recent = posts.slice(0, 5);
const startHere = await postsBySlug(site.startHere);
// Questions in reading order: brain and mind first, then body and sleep, then risks.
const questionOrder = ['neurological-correlates', 'mind-wandering', 'biological-health', 'sleep', 'adverse-effects'];
const rank = (key: string) => (questionOrder.indexOf(key) + 1 || questionOrder.length + 1);
const themes = await Promise.all(
  (await getThemes()).sort((a, b) => rank(a.data.theme_key) - rank(b.data.theme_key)).map(async (theme) => ({ theme, count: (await postsForTheme(theme)).length })),
);
// Study type and themes for each listed paper.
const meta = async (post: Post) => ({ post, type: post.data.study?.type, themes: await themesForPost(post) });
const startCards = await Promise.all(startHere.map(meta));
const recentItems = await Promise.all(recent.map(meta));

const description =
  'Accessible summaries of peer-reviewed research on meditation and the brain, from jhana and gamma waves to sleep, immune function, and mind wandering.';
---
<DefaultLayout
  title="Home"
  meta_description={description}
  schemas={[websiteSchema(description)]}
>
  <main class="content home" role="main">

    <section class="home-intro">
      <p class="home-lede">
        Plain-English summaries of peer-reviewed studies on meditation and the brain. Each one explains what the
        researchers did, what they found, and how much weight the result can bear.
      </p>
      <p class="home-author">
        Written by {site.author}, a meditator with a background in science.{' '}
        <a href="/about/">About me and this site</a>
      </p>
    </section>

    <section class="start-here" aria-labelledby="start-here-heading">
      <h2 id="start-here-heading">Start Here</h2>
      <p class="section-intro">New to the site? These four summaries are a good place to begin.</p>
      <ul class="paper-cards">
        {startCards.map(({ post, type, themes }) => (
          <li class="paper-card">
            {type && <span class="study-type">{type}</span>}
            <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
            <p class="paper-meta">{themes.map((t) => t.data.short_title).join(' · ')}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="theme-questions" aria-labelledby="questions-heading">
      <h2 id="questions-heading">Explore by Question</h2>
      <ul class="question-grid">
        {themes.map(({ theme, count }) => (
          <li class="question-card">
            <img src={themeThumb(theme)} alt="" width="240" height="240" loading="lazy" decoding="async" />
            <div>
              <h3><a href={themeUrl(theme)}>{theme.data.question}</a></h3>
              <p class="paper-meta">{theme.data.short_title} · {count} paper{count === 1 ? '' : 's'}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="recent-papers" aria-labelledby="recent-papers-heading">
      <h2 id="recent-papers-heading">Recent Papers</h2>
      <ul class="post-list">
        {recentItems.map(({ post, themes }) => (
          <li>
            <PaperMeta post={post} themes={themes} date />
            <h3><a class="post-link" href={postUrl(post)}>{post.data.title}</a></h3>
            {post.data.snippet && <p>{post.data.snippet}</p>}
          </li>
        ))}
      </ul>
      <p><a href="/all-papers/">Browse all {posts.length} papers</a> or <a href="/glossary/">look up a term in the glossary</a></p>
    </section>
  </main>
</DefaultLayout>
