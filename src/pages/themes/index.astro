---
// The research themes as questions, each with its short answer (the bold
// opening of the theme's research_summary) and the papers behind it.
import PageLayout from '../../layouts/PageLayout.astro';
import { postsForTheme, postUrl, themeShortAnswer, themesInOrder, themeThumb, themeUrl } from '../../lib/content';
import { collectionPageSchema } from '../../lib/seo';
import { site } from '../../site';

const themes = await themesInOrder();
const entries = await Promise.all(
  themes.map(async (theme) => ({ theme, posts: await postsForTheme(theme), answer: themeShortAnswer(theme) })),
);
const title = 'Research Themes';
const description = site.copy.themesDescription;
const schema = collectionPageSchema({
  path: '/themes/',
  name: title,
  description,
  items: themes.map((theme) => ({ name: theme.data.title, path: themeUrl(theme) })),
});
---
<PageLayout title={title} meta_description={description} schemas={[schema]}>
  <p>
    {site.copy.themesIntro}
  </p>

  <ol class="theme-index">
    {entries.map(({ theme, posts, answer }) => (
      <li class="theme-entry">
        {/* Decorative: the question below links to the same page. */}
        <img class="theme-entry-image" src={themeThumb(theme)} alt="" width="240" height="240" loading="lazy" decoding="async" />
        <div class="theme-entry-body">
          <p class="paper-meta">{theme.data.short_title} · {posts.length} paper{posts.length === 1 ? '' : 's'}</p>
          <h2><a href={themeUrl(theme)}>{theme.data.question}</a></h2>
          {answer && <p class="theme-answer">{answer}</p>}
          {posts.length > 0 && (
            <ul class="theme-papers">
              {posts.map((post) => (
                <li>
                  <a href={postUrl(post)}>{post.data.title}</a>
                  {post.data.study && <span class="study-type">{post.data.study.type}</span>}
                </li>
              ))}
            </ul>
          )}
          <p class="theme-more">
            <a href={themeUrl(theme)}>{theme.data.title}: what the research says</a>
          </p>
        </div>
      </li>
    ))}
  </ol>
</PageLayout>
